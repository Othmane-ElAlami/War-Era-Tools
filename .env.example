# ==============================================================================
# WarEra Tools - Configuration Environment Template
# ==============================================================================
# Copy this file to .env and adjust variables as desired.
# All parameters are optional; safe defaults are used when values are omitted.
# ==============================================================================

# ─── API & Base URLs ───
# WARERA_BASE_URL=https://app.warera.io
# WARERA_API2_URL=https://api2.warera.io/trpc
# WARERA_API4_URL=https://api4.warera.io/trpc
# WARERA_API6_URL=https://api6.warera.io/trpc

# ─── Session & Authentication ───
# Explicit override for User ID (MongoDB Object ID format).
# If left empty, your User ID is dynamically resolved from your active session.
WARERA_USER_ID=

# Explicit override for Military Unit ID (optional).
# If left empty, your MU is dynamically resolved from your active session.
WARERA_MU_ID=

# Custom path to session cookies file (default: cookies.json in project root or AppData)
# WARERA_COOKIE_FILE=./cookies.json

# ─── Automation & Combat Safety ───
# Minimum HP safety floor. Combat automation halts if HP drops below this threshold.
WARERA_HP_MIN=10

# Maximum fight iterations per automation cycle
WARERA_MAX_CYCLES=300

# Maximum retry attempts when consuming bread / eating
WARERA_EAT_RETRIES=3

# ─── Browser Automation & CDP ───
# Chrome DevTools Protocol (CDP) endpoint for browser automation
WARERA_CDP_URL=http://localhost:9222

# Explicit path to browser binary (Edge / Chrome / Chromium / Brave)
# If omitted, auto-discovered in standard system locations
# WARERA_BROWSER_PATH=
